<Window x:Class="NMS_PotentialDetector.AreaSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор области"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#66000000"
        WindowState="Maximized"
        Topmost="True">

    <Canvas x:Name="SelectionCanvas"
            Background="Transparent"
            MouseLeftButtonDown="SelectionCanvas_MouseLeftButtonDown"
            MouseMove="SelectionCanvas_MouseMove"
            MouseLeftButtonUp="SelectionCanvas_MouseLeftButtonUp">

        <Rectangle x:Name="SelectionRect"
                   Visibility="Collapsed"
                   Stroke="#00FF88"
                   Fill="#2200FF88"
                   StrokeThickness="3"
                   StrokeDashArray="4 2"/>
    </Canvas>
</Window>