<Window x:Class="NMS_PotentialDetector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NMS_PotentialDetector.ViewModels"
        xmlns:conv="clr-namespace:NMS_PotentialDetector.Converters"
        Title="NMS Potential Detector"
        Height="600"
        Width="950"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BooleanNegationConverter x:Key="BoolNegationConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Status}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>

        <Grid Grid.Row="1" Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Захваченная область -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Текущий захват" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <Border Margin="8" Background="#1E1E1E1E" CornerRadius="12" Padding="10">
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" Height="300"/>
                </Border>
            </StackPanel>

            <!-- Шаблон -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Шаблон сравнения" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <Border Margin="8" Background="#1E1E1E1E" CornerRadius="12" Padding="10">
                    <Image Source="{Binding TemplateImage}" Stretch="Uniform" Height="300"/>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Select Area" Command="{Binding SelectAreaCommand}"/>
            <Button Content="Start" Command="{Binding StartMonitoringCommand}" IsEnabled="{Binding IsMonitoring, Converter={StaticResource BoolNegationConverter}}"/>
            <Button Content="Stop" Command="{Binding StopMonitoringCommand}" IsEnabled="{Binding IsMonitoring}"/>
        </StackPanel>
    </Grid>
</Window>