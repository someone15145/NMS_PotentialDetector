<Window x:Class="NMS_PotentialDetector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NMS_PotentialDetector.ViewModels"
        xmlns:conv="clr-namespace:NMS_PotentialDetector.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <conv:BooleanNegationConverter x:Key="BoolNegate"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Статус -->
        <TextBlock Grid.Row="0" Text="{Binding Status}" FontSize="18" HorizontalAlignment="Center"/>

        <!-- Preview -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Левое превью: область захвата -->
            <StackPanel Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="Превью отслеживаемой области" FontSize="14" HorizontalAlignment="Center"/>
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" MaxHeight="280" MaxWidth="380"/>
            </StackPanel>

            <!-- Правое превью: шаблон -->
            <StackPanel Grid.Column="2" Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="Шаблон (с которым сравнивается)" FontSize="14" HorizontalAlignment="Center"/>
                <Image Source="{Binding TemplatePreviewImage}" Stretch="Uniform" MaxHeight="280" MaxWidth="380"/>
            </StackPanel>
        </Grid>

        <!-- Координаты -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="X:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding CaptureArea.X, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="5"/>
            <TextBlock Text="Y:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding CaptureArea.Y, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="5"/>
            <TextBlock Text="W:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding CaptureArea.Width, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="5"/>
            <TextBlock Text="H:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding CaptureArea.Height, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="5"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
            <Button Content="Выбрать область" Command="{Binding SelectAreaCommand}" Margin="10"/>
            <Button Content="Старт" Command="{Binding StartMonitoringCommand}" 
            IsEnabled="{Binding IsMonitoring, Converter={StaticResource BoolNegate}}" Margin="10"/>
            <Button Content="Стоп" Command="{Binding StopMonitoringCommand}" 
            IsEnabled="{Binding IsMonitoring}" Margin="10"/>
            <CheckBox Content="Показывать превью всегда" IsChecked="{Binding AlwaysShowPreview}" 
              Margin="10" VerticalAlignment="Center" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,10">
            <TextBlock Text="{Binding CurrentMatchScore, StringFormat='Текущее соответствие: {0:P1}'}" 
               FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding MatchThreshold, StringFormat='Порог: {0:P1}'}" 
               FontSize="14" HorizontalAlignment="Center" Margin="0,5"/>

            <Slider Minimum="0.5" Maximum="1.0" Value="{Binding MatchThreshold}" 
            TickFrequency="0.01" IsSnapToTickEnabled="True" Width="300"
            Margin="0,5"/>
        </StackPanel>
    </Grid>
</Window>
