<Window x:Class="NMS_PotentialDetector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NMS_PotentialDetector.ViewModels"
        xmlns:conv="clr-namespace:NMS_PotentialDetector.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <conv:BooleanNegationConverter x:Key="BoolNegate"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Статус -->
        <TextBlock Grid.Row="0" Text="{Binding Status}" FontSize="18" HorizontalAlignment="Center"/>

        <!-- Preview -->
        <Image Grid.Row="1" Source="{Binding PreviewImage}" Stretch="Uniform" MaxHeight="300"/>

        <!-- Координаты -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="X:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding CaptureArea.X, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="5"/>
            <TextBlock Text="Y:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding CaptureArea.Y, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="5"/>
            <TextBlock Text="W:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding CaptureArea.Width, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="5"/>
            <TextBlock Text="H:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding CaptureArea.Height, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="5"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
            <Button Content="Выбрать область" Command="{Binding SelectAreaCommand}" Margin="10"/>
            <Button Content="Старт" Command="{Binding StartMonitoringCommand}" IsEnabled="{Binding IsMonitoring, Converter={StaticResource BoolNegate}}" Margin="10"/>
            <Button Content="Стоп" Command="{Binding StopMonitoringCommand}" IsEnabled="{Binding IsMonitoring}"/>
        </StackPanel>
    </Grid>
</Window>
